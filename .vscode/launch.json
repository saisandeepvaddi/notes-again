  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["--app-dir", "backend", "main:app", "--reload", "--host", "0.0.0.0"],
      "env": {
        "AUTH_DISABLED": "1",
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "CORS_ORIGIN_REGEX": "http://(localhost|127\\.0\\.0\\.1|10\\.\\d+\\.\\d+\\.\\d+|172\\.(1[6-9]|2\\d|3[01])\\.\\d+\\.\\d+|192\\.168\\.\\d+\\.\\d+):5173"
      },
      "jinja": false
    }
  ]
}
