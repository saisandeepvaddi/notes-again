# Copy to .env and fill in. docker-compose reads this file.

# --- Runtime ---------------------------------------------------------------
PORT=8000
DB_PATH=/data/notes-again.db
FRONTEND_DIST=/app/frontend/dist/client

# Only set when the frontend is served from a different origin (i.e. local
# dev with Vite). In the container the SPA is same-origin, so leave this
# empty and no CORS headers are emitted.
CORS_ORIGINS=

# --- Auth -------------------------------------------------------------------
# local (default): username + password stored in the DB. The first start prints
#   a temporary admin password to the logs; you pick your own after signing in.
# firebase: see docs/firebase-auth.md.
# none: no login. Only for a server nobody else can reach.
AUTH_MODE=local

# Optional: skip the temporary password by creating the account with these.
# Only used when the account is first created.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Firebase (only with AUTH_MODE=firebase; see docs/firebase-auth.md) ------
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=<project-id>
# FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json
# COMPOSE_FILE=docker-compose.yml:docker-compose.firebase.yml
# ALLOWED_EMAILS=

# --- Litestream backup to Cloudflare R2 (optional, recommended) ----------
# In the Cloudflare dashboard: create an R2 bucket, then an R2 API token
# ("Object Read & Write"), which gives you an S3 access key id + secret.
# Leave these unset to run without backups.
# R2_BUCKET=notes-again-backups
# R2_PATH=db
# R2_ENDPOINT=<your-account-id>.r2.cloudflarestorage.com
# LITESTREAM_ACCESS_KEY_ID=<r2-access-key-id>
# LITESTREAM_SECRET_ACCESS_KEY=<r2-secret-access-key>
